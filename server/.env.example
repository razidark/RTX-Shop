# Copy to .env and fill in real values. `.env` is gitignored.
# The dev database (server/prisma/dev.db) is also gitignored.

# SQLite path for the Prisma client
DATABASE_URL="file:./dev.db"

# Signing key for admin/customer tokens. Must be at least 32 characters.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=""
